{
  "name": "k8s-workshop-backend",
  "version": "1.0.0",
  "description": "Backend API for K8s Workshop - Node.js Express with PostgreSQL",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:manifests": "vitest run --config vitest.manifests.config.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "fast-check": "^3.15.0",
    "js-yaml": "^4.1.0",
    "supertest": "^6.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
